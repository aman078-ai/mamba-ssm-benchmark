{
  "config": "configs/stage3_lr_sweep.json",
  "spec": {
    "name": "stage3_lr_sweep",
    "description": "Per-architecture learning-rate sweep for the research models (validation split only). 1,500 steps of 16 x 512 bytes, full cosine schedule, seed 0. NoPE/ALiBi Transformers and the LTI Mamba reuse the LR chosen for their family. Extended to 0.016 and 0.032 because both families were still improving at 0.008.",
    "out": "results/research/stage3_lr_sweep",
    "common": {
      "steps": 1500,
      "seq_len": 512,
      "batch_size": 16,
      "warmup": 100,
      "min_lr": 0.0001,
      "eval_every": 250,
      "eval_bytes": 1000000
    },
    "variants": {
      "mamba_n16": {
        "model": "mamba",
        "override": {
          "d_model": 128,
          "layers": "MMMMMMMM",
          "d_state": 16
        }
      },
      "transformer_rope": {
        "model": "transformer",
        "override": {
          "d_model": 128,
          "layers": "AAAAA",
          "pos_encoding": "rope"
        }
      }
    },
    "grid": {
      "lr": [
        0.001,
        0.002,
        0.004,
        0.008,
        0.016,
        0.032
      ],
      "seed": [
        0
      ]
    }
  },
