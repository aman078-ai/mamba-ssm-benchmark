{
  "config": "configs/stage5d_passkey_stream_mamba.json",
  "spec": {
    "name": "stage5d_passkey_stream_mamba",
    "description": "Position-free passkey protocol (data.passkey.insert_passkey_stream): each 512-byte training window contains a passkey with probability 0.5; STORE uniform over the window; RECALL 16-448 bytes later, truncated at the window end. Fixed budget of 10,000 steps x 16 x 512 bytes (81.9M bytes), no early stopping; 3 seeds. Recall is evaluated inside the training length (gaps 64-512) before extrapolation (up to 16K).",
    "out": "results/research/stage5d_passkey_stream_mamba",
    "common": {
      "steps": 10000,
      "seq_len": 512,
      "batch_size": 16,
      "warmup": 200,
      "min_lr": 0.0001,
      "eval_every": 2000,
      "eval_bytes": 1000000,
      "passkey_len": 8,
      "passkey_prob": 0.5,
      "passkey_gap_min": 16,
      "passkey_gap_max": 448
    },
    "variants": {
      "mamba_s4d_n16": {
        "model": "mamba",
        "lr": 0.016,
        "override": {
          "d_model": 128,
          "layers": "MMMMMMMM",
          "d_state": 16,
          "a_mode": "s4d"
        }
      }
    },
    "grid": {
      "seed": [
        0,
        1,
        2
      ]
    },
    "post": [
      [
        "-m",
        "analysis.passkey_eval",
        "--run_dir",
        "{run_dir}"
      ],
      [
        "-m",
        "analysis.length_generalization",
        "--run_dir",
        "{run_dir}",
        "--max_len",
        "16384",
        "--position_windows",
        "16"
      ],
      [
        "-m",
        "analysis.passkey_text_control",
        "--run_dir",
        "{run_dir}"
      ]
    ]
  },
  "runs": {
    "mamba_s4d_n16_seed0": {
      "status": "done",
      "args": {
        "steps": 10000,
        "seq_len": 512,
        "batch_size": 16,
        "warmup": 200,
        "min_lr": 0.0001,
        "eval_every": 2000,
        "eval_bytes": 1000000,
        "passkey_len": 8,
        "passkey_prob": 0.5,
        "passkey_gap_min": 16,
        "passkey_gap_max": 448,
        "model": "mamba",
        "lr": 0.016,
        "override": {
          "d_model": 128,
          "layers": "MMMMMMMM",
          "d_state": 16,
          "a_mode": "s4d"
        },
        "seed": 0
      }
    },
    "mamba_s4d_n16_seed1": {
